    {
      "name": "Custom Package",
      "pkg": "com.your.custom.package",
      "enabled": false,
      "_comment": "Thêm package tùy chỉnh của bạn vào đây"
    }
  ],

  "active_package": "com.roblox.client",
  "_comment_pkg": "Package đang được theo dõi chính",

  "game": {
    "place_id": "12345678",
    "_comment_pid": "Place ID của game bạn muốn farm. Lấy từ URL: roblox.com/games/XXXXXXXXX",
    "access_code": "",
    "_comment_code": "Access code của VIP/Private server (để trống nếu public game)",
    "is_private": false,
    "_comment_private": "true = VIP/Private server, false = public game",
    "full_link": "",
    "_comment_link": "Dán toàn bộ VIP link vào đây thay vì nhập từng phần. Ví dụ: https://www.roblox.com/games/12345678?privateServerLinkCode=ABCDEF123"
  },

  "timing": {
    "check_interval": 5,
    "_comment_ci": "Mỗi X giây kiểm tra trạng thái game 1 lần (khuyến nghị: 3-8)",
    "rejoin_delay": 8,
    "_comment_rd": "Đợi X giây sau khi kill app trước khi rejoin (để app đóng hẳn)",
    "max_retries": 10,
    "_comment_mr": "Thử rejoin tối đa bao nhiêu lần trước khi báo thất bại",
    "retry_cooldown": 30,
    "_comment_rc": "Đợi X giây giữa các lần thử thất bại liên tiếp"
  },

  "detection": {
    "use_logcat": true,
    "_comment_lc": "Dùng logcat để phát hiện disconnect (chính xác nhưng tốn pin hơn)",
    "use_activity": true,
    "_comment_act": "Dùng dumpsys activity để kiểm tra top activity (khuyến nghị)",
    "use_cpu": true,
    "_comment_cpu": "Monitor CPU usage để phát hiện app idle quá lâu",
    "cpu_threshold": 5,
    "_comment_ct": "Ngưỡng CPU % - dưới mức này coi là idle",
    "cpu_low_duration": 20,
    "_comment_cld": "Số vòng check CPU idle liên tiếp trước khi kết luận cần rejoin"
  },

  "webhook": {
    "enabled": false,
    "_comment_wh": "Bật/tắt thông báo Discord",
    "url": "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN",
    "_comment_url": "Webhook URL lấy từ Discord: Server Settings → Integrations → Webhooks",
    "notify_rejoin": true,
    "notify_crash": true,
    "notify_success": true,
    "username": "Roblox AutoRejoin",
    "_comment_name": "Tên bot hiển thị trong Discord",
    "avatar_url": "https://i.imgur.com/roblox-avatar.png",
    "_comment_avatar": "Link ảnh đại diện bot (để trống cũng được)"
  },

  "advanced": {
