{
  "_comment": "Copy this file to config.json and edit as needed",
  "version": "2.0.0",

  "packages": [
    {
      "name": "Official Roblox",
      "pkg": "com.roblox.client",
      "enabled": true,
      "_comment": "Official Roblox package name"
    },
    {
      "name": "Delta Executor",
      "pkg": "com.vng.njnj",
      "enabled": false,
      "_comment": "Replace pkg with the actual Delta package name (may change per version)"
    },
    {
      "name": "Codex Executor",
      "pkg": "com.codex.client",
      "enabled": false,
      "_comment": "Replace pkg with the actual Codex package name"
    },
    {
      "name": "Fluxus",
      "pkg": "com.fluxteam.fluxus",
      "enabled": false
    },
    {
      "name": "Arceus X",
      "pkg": "com.arceusx.neo",
      "enabled": false
    },
    {
      "name": "Custom Package",
      "pkg": "com.your.custom.package",
      "enabled": false,
      "_comment": "Add your custom package here"
    }
  ],

  "active_package": "com.roblox.client",
  "_comment_pkg": "Primary package being monitored",

  "game": {
    "place_id": "12345678",
    "_comment_pid": "Place ID of the game you want to farm. Get it from URL: roblox.com/games/XXXXXXXXX",
    "access_code": "",
    "_comment_code": "Access code for VIP/Private server (leave empty for public games)",
    "is_private": false,
    "_comment_private": "true = VIP/Private server, false = public game",
    "full_link": "",
    "_comment_link": "Paste the full VIP link here instead of entering parts. Example: https://www.roblox.com/games/12345678?privateServerLinkCode=ABCDEF123"
  },

  "timing": {
    "check_interval": 5,
    "_comment_ci": "Check game status every X seconds (recommended: 3-8)",
    "rejoin_delay": 8,
    "_comment_rd": "Wait X seconds after killing app before rejoining (let the app fully close)",
    "max_retries": 10,
    "_comment_mr": "Maximum rejoin attempts before reporting failure",
    "retry_cooldown": 30,
    "_comment_rc": "Wait X seconds between consecutive failed attempts"
  },

  "detection": {
    "use_logcat": true,
    "_comment_lc": "Use logcat to detect disconnect (more accurate but uses more battery)",
    "use_activity": true,
    "_comment_act": "Use dumpsys activity to check top activity (recommended)",
    "use_cpu": true,
    "_comment_cpu": "Monitor CPU usage to detect prolonged app idle",
    "cpu_threshold": 5,
    "_comment_ct": "CPU % threshold — below this is considered idle",
    "cpu_low_duration": 20,
    "_comment_cld": "Number of consecutive idle CPU checks before triggering rejoin"
  },

  "webhook": {
    "enabled": false,
    "_comment_wh": "Enable/disable Discord notifications",
    "url": "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN",
    "_comment_url": "Webhook URL from Discord: Server Settings → Integrations → Webhooks",
    "notify_rejoin": true,
    "notify_crash": true,
    "notify_success": true,
    "username": "Roblox AutoRejoin",
    "_comment_name": "Bot display name in Discord",
    "avatar_url": "https://i.imgur.com/roblox-avatar.png",
    "_comment_avatar": "Bot avatar image URL (can be left empty)"
  },

  "advanced": {
    "auto_clear_cache": false,
    "_comment_acc": "Automatically clear Roblox cache periodically (helps avoid accumulated errors)",
    "clear_cache_interval": 3600,
    "_comment_cci": "Clear cache every X seconds (3600 = 1 hour)",
    "change_android_id": false,
    "_comment_cai": "Change Android ID after each rejoin (to avoid detection, risky!)",
    "auto_boot": false,
    "_comment_ab": "Auto-run when Termux starts (requires adding to .bashrc)",
    "kill_on_start": true,
    "_comment_kos": "Kill current Roblox instance when starting auto rejoin"
  },

  "stats": {
    "total_rejoins": 0,
    "total_crashes": 0,
    "last_rejoin": "",
    "start_time": ""
  }
}
